{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/og-image-v3.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og-image-v2.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/invite", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dsa", "destination": "/index.html" },
    { "source": "/system-design/:kind", "destination": "/index.html" },
    { "source": "/blogs", "destination": "/index.html" },
    { "source": "/blogs/new", "destination": "/index.html" },
    { "source": "/blogs/:slug", "destination": "/index.html" },
    { "source": "/blogs/:slug/edit", "destination": "/index.html" },
    { "source": "/recap", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/optimus/new/:problemId", "destination": "/index.html" },
    { "source": "/optimus/:attemptId", "destination": "/index.html" },
    { "source": "/billing/success", "destination": "/index.html" }
  ]
}
